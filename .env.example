# Copy to .env and fill in real values. Never commit .env.
#   python -c "import secrets; print(secrets.token_hex(32))"   -> generates a strong secret

# development | testing | production
APP_ENV=development

SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# Relative SQLite paths live in the instance/ folder. Docker overrides this.
DATABASE_URL=sqlite:///disaster_response.db

# Comma-separated origins of the React frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Password for demo accounts created by `flask seed`
SEED_DEFAULT_PASSWORD=Password@123

# Docker only: load demo data on container start
SEED_DEMO_DATA=false
API_PORT=5000
